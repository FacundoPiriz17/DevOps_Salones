# Upload real values to Jenkins as a Secret file: salones-app-secrets.
# Use independent random hex passwords (at least 24 characters) for the DB roles.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
DB_LOGIN_PASSWORD=REPLACE_WITH_RANDOM_LOGIN_PASSWORD
DB_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
DB_FUNC_PASSWORD=REPLACE_WITH_RANDOM_STAFF_PASSWORD
DB_PART_PASSWORD=REPLACE_WITH_RANDOM_STUDENT_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_JWT_SIGNING_KEY
