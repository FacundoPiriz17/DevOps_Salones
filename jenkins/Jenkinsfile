pipeline {
    agent any

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    parameters {
        booleanParam(name: 'PUBLISH_IMAGES', defaultValue: true, description: 'Publicar las dos imágenes solo desde main; requiere configurar el registro y sus credenciales.')
        booleanParam(name: 'DEPLOY_TO_KUBERNETES', defaultValue: true, description: 'Publicar y desplegar main en el laboratorio. Requiere PUBLISH_IMAGES y las credenciales indicadas.')
        string(name: 'REGISTRY_PREFIX', defaultValue: 'docker.io/facundopiriz17', description: 'Registro/cuenta de las imágenes, sin barra final.')
        string(name: 'REGISTRY_HOST', defaultValue: 'docker.io', description: 'Host del registro para docker login, sin esquema ni ruta.')
        string(name: 'REGISTRY_CREDENTIALS_ID', defaultValue: 'salones-registry', description: 'ID de credenciales Jenkins de tipo Username with password.')
        string(name: 'KUBECONFIG_CREDENTIALS_ID', defaultValue: 'salones-kubeconfig', description: 'Credencial Secret file con kubeconfig del laboratorio.')
        string(name: 'APP_SECRETS_CREDENTIALS_ID', defaultValue: 'salones-app-secrets', description: 'Credencial Secret file con variables según jenkins/app-secrets.env.example.')
        string(name: 'K8S_NAMESPACE', defaultValue: 'alumno-team9', description: 'Namespace preexistente asignado al equipo.')
        string(name: 'APP_HOST', defaultValue: 'salones-team9.reto-ucu.net', description: 'Hostname público del Ingress, sin esquema ni ruta.')
        choice(name: 'APP_SCHEME', choices: ['https', 'http'], description: 'Protocolo de la URL pública. En este laboratorio HTTP apunta al sitio del Coro; usar HTTPS.')
        string(name: 'INGRESS_CLASS', defaultValue: 'apisix', description: 'Clase del controlador que publica la aplicación en el laboratorio.')
        choice(name: 'PUBLIC_TLS_POLICY', choices: ['pinned-lab', 'strict'], description: 'Excepción temporal del laboratorio: solo chequeo anónimo de salones-team9 y con clave pública fijada. strict exige certificado válido.')
        string(name: 'LAB_TLS_PUBLIC_KEY_PIN', defaultValue: 'sha256//6CPD0jhjNe+e2vHadtfc3GiOnozYlc8l+aGWlEvRJQE=', description: 'Huella pública del certificado del laboratorio. No es una contraseña; una clave distinta bloquea la excepción.')
    }

    stages {
        stage('Checkout y entorno') {
            steps {
                checkout scm
                script {
                    env.CI_BRANCH = (env.GIT_BRANCH ?: '').replaceFirst('^origin/', '')
                    if (env.CI_BRANCH != 'main') {
                        error('Este job acepta únicamente main. Configurá Branch Specifier como */main.')
                    }
                    if (params.DEPLOY_TO_KUBERNETES && !params.PUBLISH_IMAGES) {
                        error('El despliegue requiere PUBLISH_IMAGES para que el clúster pueda descargar esta versión.')
                    }
                    if (params.PUBLISH_IMAGES && !params.REGISTRY_PREFIX.trim()) {
                        error('Configurá REGISTRY_PREFIX antes de habilitar la publicación.')
                    }
                    sh '''
                        set -eu
                        test "$(git rev-parse HEAD)" = "$(git rev-parse refs/remotes/origin/main)"
                        docker info > /dev/null
                    '''
                    def jobId = sh(script: 'printf "%s" "$JOB_NAME" | cksum | cut -d " " -f 1', returnStdout: true).trim()
                    env.CI_RUN_ID = "salones-ci-${jobId}-${env.BUILD_NUMBER}"
                }
                dir('reports') {
                    deleteDir()
                }
                sh 'mkdir -p reports'
            }
        }

        stage('Pruebas unitarias del backend') {
            steps {
                sh 'sh jenkins/ci.sh unit'
            }
            post {
                always {
                    script {
                        if (fileExists('reports/backend-unit-junit.xml')) {
                            junit testResults: 'reports/*unit-junit.xml', allowEmptyResults: false
                        }
                    }
                }
            }
        }

        stage('Integración con MySQL temporal') {
            steps {
                sh 'sh jenkins/ci.sh integration'
            }
            post {
                always {
                    script {
                        if (fileExists('reports/backend-mysql-junit.xml')) {
                            junit testResults: 'reports/backend-mysql-junit.xml', allowEmptyResults: false
                        }
                    }
                }
            }
        }

        stage('Validar frontend y construir imágenes') {
            steps {
                sh 'sh jenkins/ci.sh images'
            }
        }

        stage('Verificar imágenes de producción') {
            steps {
                sh 'sh jenkins/smoke.sh'
            }
        }

        stage('Validar manifiestos de Kubernetes') {
            steps {
                sh 'REGISTRY_PREFIX="${REGISTRY_PREFIX:-docker.io/unpublished}" sh jenkins/deploy.sh render'
            }
        }

        stage('Publicar imágenes') {
            when {
                expression { params.PUBLISH_IMAGES && env.CI_BRANCH == 'main' }
            }
            steps {
                script {
                    if (!params.REGISTRY_PREFIX.trim()) {
                        error('Configurá REGISTRY_PREFIX antes de habilitar la publicación.')
                    }
                }
                withCredentials([usernamePassword(credentialsId: params.REGISTRY_CREDENTIALS_ID, usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh '''
                        set -eu
                        case "$REGISTRY_HOST" in
                            ''|-*|*[!a-zA-Z0-9.:-]*) echo 'REGISTRY_HOST inválido' >&2; exit 2 ;;
                        esac
                        DOCKER_CONFIG=$(mktemp -d)
                        export DOCKER_CONFIG
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT HUP INT TERM
                        set +x
                        printf '%s' "$REGISTRY_PASSWORD" | docker login "$REGISTRY_HOST" --username "$REGISTRY_USER" --password-stdin
                        sh jenkins/ci.sh publish
                    '''
                }
            }
        }

        stage('Desplegar en Kubernetes del laboratorio') {
            when {
                expression { params.DEPLOY_TO_KUBERNETES && env.CI_BRANCH == 'main' }
            }
            steps {
                withCredentials([
                    file(credentialsId: params.KUBECONFIG_CREDENTIALS_ID, variable: 'KUBECONFIG'),
                    file(credentialsId: params.APP_SECRETS_CREDENTIALS_ID, variable: 'APP_SECRETS_FILE')
                ]) {
                    sh 'sh jenkins/deploy.sh deploy'
                }
            }
        }

        stage('Verificar URL pública') {
            when {
                expression { params.DEPLOY_TO_KUBERNETES && env.CI_BRANCH == 'main' }
            }
            steps {
                withEnv([
                    "PUBLIC_TLS_POLICY=${params.PUBLIC_TLS_POLICY}",
                    "LAB_TLS_PUBLIC_KEY_PIN=${params.LAB_TLS_PUBLIC_KEY_PIN}"
                ]) {
                    sh 'sh jenkins/verify-public.sh'
                }
                script {
                    if (fileExists('reports/public-tls-warning.txt')) {
                        currentBuild.description = 'main: desplegado; excepción TLS temporal del laboratorio con clave fijada'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
                } finally {
                    if (env.CI_RUN_ID) {
                        sh 'sh jenkins/ci.sh cleanup'
                    }
                }
            }
        }
        success {
            echo 'Salones: etapas habilitadas completadas. Ver JUnit, cobertura, imágenes y deployment-url.txt si se habilitó el despliegue.'
        }
        failure {
            echo 'Falló la validación de Salones. No se ejecutan las etapas siguientes; revisar los reportes del build.'
        }
    }
}
